# ─────────────────────────────────────────────────────────────────────────────
# このファイルを .env にコピーして使用する。.env は git 管理対象外。
# cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=flutter_learning

# ── LLM ──────────────────────────────────────────────────────────────────────
# 使用するプロバイダーの API キーとモデル ID を設定する。
# バックエンドの LlmClient 層がプロバイダーを抽象化するため、
# ここで指定したモデルに合わせてクライアント実装を選択する。
LLM_API_KEY=your_api_key_here
LLM_MODEL=your_model_id_here

# ── ビルド設定 ────────────────────────────────────────────────────────────────
# タイムアウトはセキュリティ方針に従い 5 分（300 秒）を基準とする
BUILD_TIMEOUT_SECONDS=300
BUILD_MAX_CONCURRENCY=2

# builder コンテナで使用する Flutter SDK バージョン
# docker/builder/Dockerfile の ARG FLUTTER_VERSION と合わせる
FLUTTER_SDK_VERSION=3.27.4

# ── ストレージパス ─────────────────────────────────────────────────────────────
# 以下はコンテナ内パスのため通常は変更不要。
# 構造: /lesson-projects/{lessonId}/initial/  ← initialProjectRef
#       /lesson-projects/{lessonId}/solution/ ← solutionProjectRef
LESSON_PROJECT_ROOT=/lesson-projects
BUILD_WORKSPACE_ROOT=/workspace
BUILD_ARTIFACT_ROOT=/artifacts

# アップロード制限 (bytes)
UPLOAD_MAX_FILE_SIZE=1048576     # 1 MB
UPLOAD_MAX_TOTAL_SIZE=52428800   # 50 MB
UPLOAD_MAX_FILE_COUNT=500
